# TraceFresh-AI Environment Configuration Template

# Server Environment & Port Configuration
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Secrets Configuration (Change in production!)
SECRET_KEY=tracefresh-super-secret-key-change-in-production-2026
JWT_SECRET_KEY=tracefresh-jwt-secret-key-change-in-production-2026
X_DEVICE_TOKEN=tracefresh-device-ingest-token-2026

# Database Persistence Configuration
# Omit DATABASE_URL for local development to use embedded SQLite (backend/data/tracefresh.db)
# For production PostgreSQL: postgresql://user:password@localhost:5432/tracefresh_db
DATABASE_URL=

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Configuration
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Logging & Telemetry Configuration
LOG_LEVEL=INFO
TELEMETRY_STALE_SECONDS=30

# Hardware Wi-Fi Defaults
WIFI_SSID=YourWiFiNetworkName
WIFI_PASSWORD=YourWiFiPassword
BACKEND_URL=http://192.168.1.100:5000/api/telemetry
